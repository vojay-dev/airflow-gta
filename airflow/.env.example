# Local Ollama on the host, decision model over the System One API (POST /v1/systemone).
AIRFLOW_CONN_OLLAMA_DECISIONS='{
    "conn_type": "pydanticai",
    "host": "http://host.docker.internal:11434",
    "extra": {"model": "system-one:nimble"}
}'
# The GTA2 bridge (../bridge/bridge.py) on the host.
GTA2_BRIDGE_URL=http://host.docker.internal:8765
